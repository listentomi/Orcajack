# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Only the provider(s) you actually use need to be set.

# OpenAI-compatible endpoint. Also covers SiliconFlow and any local vLLM server:
# set this key and point `api_base` (orchestrator/config.yaml, or the --*-api-base
# flags) at the provider. For a local vLLM server any non-empty value works,
# e.g. OPENAI_API_KEY=dummy
OPENAI_API_KEY=

# OpenRouter, for model IDs prefixed "openrouter/".
OPENROUTER_API_KEY=

# Yunwu relay, for model IDs prefixed "yunwu/". Falls back to OPENAI_API_KEY if unset.
YUNWU_API_KEY=

# Optional. OpenRouter attribution headers; both default to a neutral placeholder.
# OPENROUTER_APP_NAME=
# OPENROUTER_REFERRER=
