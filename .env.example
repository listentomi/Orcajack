# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Only the provider(s) you actually use need to be set.

# OpenAI-compatible endpoint (also used for local vLLM servers).
# For a local vLLM server any non-empty value works, e.g. OPENAI_API_KEY=dummy
OPENAI_API_KEY=

# OpenRouter (model IDs prefixed "openrouter/")
OPENROUTER_API_KEY=

# SiliconFlow (default api_base in orchestrator/config.yaml)
SILICONFLOW_API_KEY=
